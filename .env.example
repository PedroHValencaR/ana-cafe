# Found in https://www.sanity.io/manage → your project → API settings
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2025-02-19"

# Public URL of the deployed site (used for metadata, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Shared secret for the Sanity webhook that clears the content cache.
# Required in production if you want changes to appear immediately.
SANITY_REVALIDATE_SECRET="replace-with-a-long-random-string"
